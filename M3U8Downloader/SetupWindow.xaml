<Window x:Class="M3U8Downloader.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M3U8 Downloader — Sozlash"
        Width="420" Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrBgMain}">

  <Grid Margin="32,28,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Logo + Title -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="&lt;|&gt;" FontSize="22" FontWeight="Bold"
                 Foreground="{DynamicResource BrAccent}" FontFamily="Consolas"/>
      <StackPanel Margin="10,2,0,0">
        <TextBlock Text="M3U8 Downloader" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrTextPrimary}"/>
        <TextBlock Text="Birinchi marta sozlash" FontSize="11"
                   Foreground="{DynamicResource BrTextSecondary}"/>
      </StackPanel>
    </StackPanel>

    <!-- Divider -->
    <Border Grid.Row="1" Height="1" Background="{DynamicResource BrBorder}" Margin="0,10,0,16"/>

    <!-- Status text -->
    <TextBlock x:Name="StatusText" Grid.Row="2"
               Text="yt-dlp va ffmpeg yuklab o'rnatiladi."
               FontSize="12" Foreground="{DynamicResource BrTextSecondary}"
               TextWrapping="Wrap" Margin="0,0,0,10"/>

    <!-- Log area -->
    <Border Grid.Row="3" Background="{DynamicResource BrBgCard}"
            CornerRadius="6" BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
            Margin="0,0,0,14" Padding="10,8">
      <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="LogText" FontSize="11" FontFamily="Consolas"
                   Foreground="{DynamicResource BrTextSecondary}"
                   TextWrapping="Wrap" LineHeight="18"/>
      </ScrollViewer>
    </Border>

    <!-- Progress bar -->
    <ProgressBar x:Name="ProgressBar" Grid.Row="4"
                 Style="{StaticResource SetupProgress}"
                 Minimum="0" Maximum="100" Value="0"
                 Margin="0,0,0,6"/>

    <!-- Percent label -->
    <TextBlock x:Name="PctText" Grid.Row="5"
               Text="" FontSize="11"
               Foreground="{DynamicResource BrTextSecondary}"
               HorizontalAlignment="Right" Margin="0,0,0,14"/>

    <!-- Buttons -->
    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="SkipBtn" Grid.Column="0" Content="O'tkazib yuborish"
              Style="{StaticResource SecondaryBtn}" Click="SkipBtn_Click"
              ToolTip="yt-dlp va ffmpeg PATH da bo'lsa ishlaydi"/>
      <Button x:Name="InstallBtn" Grid.Column="2" Content="O'rnatish"
              Style="{StaticResource PrimaryBtn}" Click="InstallBtn_Click"/>
    </Grid>
  </Grid>
</Window>
