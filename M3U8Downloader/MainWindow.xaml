<Window x:Class="M3U8Downloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M3U8 Downloader"
        Width="520" Height="580"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrBgMain}">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="32" CornerRadius="0"
                  GlassFrameThickness="0,0,0,1"
                  ResizeBorderThickness="0"/>
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Custom title bar -->
    <Grid Grid.Row="0" Background="{DynamicResource BrBgCard}"
          MouseLeftButtonDown="TitleBar_MouseDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="46"/>
        <ColumnDefinition Width="46"/>
      </Grid.ColumnDefinitions>

      <!-- Title -->
      <StackPanel Grid.Column="0" Orientation="Horizontal"
                  VerticalAlignment="Center" Margin="12,0,0,0">
        <TextBlock Text="&lt;/&gt;" FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                   Foreground="{DynamicResource BrAccent}" VerticalAlignment="Center"/>
        <TextBlock Text=" M3U8 " FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrAccent}" VerticalAlignment="Center"/>
        <TextBlock x:Name="TitleD" Text="Yuklovchi" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrTextPrimary}" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- EN/UZ button — o'z Column da, WindowChrome hit area dan tashqarida -->
      <Button x:Name="LangBtn" Grid.Column="1"
              Content="EN" Click="LangBtn_Click"
              WindowChrome.IsHitTestVisibleInChrome="True"
              Width="34" Height="20" Margin="0,0,6,0"
              FontSize="10" FontWeight="Bold"
              Background="#FF2E2E2E" Foreground="#FFDDDDDD"
              BorderThickness="1" BorderBrush="#FF505050"
              Cursor="Hand" VerticalAlignment="Center">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF3A3A3A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>

      <!-- Minimize -->
      <Button Grid.Column="2" Content="─" Width="46" Height="32"
              WindowChrome.IsHitTestVisibleInChrome="True"
              Click="MinBtn_Click" FontSize="12"
              Background="Transparent" Foreground="#FF888888"
              BorderThickness="0" Cursor="Hand">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF333333"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>

      <!-- Close -->
      <Button Grid.Column="3" Content="✕" Width="46" Height="32"
              WindowChrome.IsHitTestVisibleInChrome="True"
              Click="CloseBtn_Click" FontSize="12"
              Background="Transparent" Foreground="#FF888888"
              BorderThickness="0" Cursor="Hand">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FFCF6679"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </Grid>

    <!-- Main content -->
    <Grid Grid.Row="1" Margin="16,12,16,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Link row -->
      <Grid Grid.Row="0" Margin="0,0,0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="LblLink" Grid.Row="0" Text="M3U8 link" FontSize="11"
                   Foreground="{DynamicResource BrTextSecondary}" Margin="0,0,0,4"/>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="LinkBox" Grid.Column="0" Style="{StaticResource InputBox}"
                   VerticalContentAlignment="Center"/>
          <Button x:Name="PasteBtn" Grid.Column="1" Content="Joylash"
                  Margin="6,0,0,0" Style="{StaticResource SecondaryBtn}"
                  Click="PasteBtn_Click"/>
          <Button x:Name="BrowserBtn" Grid.Column="2" Content="🌐"
                  Margin="6,0,0,0" Style="{StaticResource SecondaryBtn}"
                  Click="BrowserBtn_Click"/>
        </Grid>
      </Grid>

      <!-- Title + Folder -->
      <Grid Grid.Row="1" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock x:Name="LblTitle" Text="Video nomi" FontSize="11"
                     Foreground="{DynamicResource BrTextSecondary}" Margin="0,0,0,4"/>
          <TextBox x:Name="TitleBox" Style="{StaticResource InputBox}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock x:Name="LblFolder" Text="Saqlash joyi" FontSize="11"
                     Foreground="{DynamicResource BrTextSecondary}" Margin="0,0,0,4"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" Grid.Column="0" Style="{StaticResource InputBox}" IsReadOnly="True"/>
            <Button x:Name="FolderBtn" Grid.Column="1" Margin="4,0,0,0"
                    Style="{StaticResource IconBtn}" Width="34"
                    Click="FolderBtn_Click" ToolTip="Papka tanlash">
              <TextBlock Text="..." FontSize="15" FontWeight="Bold"
                         Foreground="#FFEEEEEE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="OpenFolderBtn" Grid.Column="2" Margin="4,0,0,0"
                    Style="{StaticResource IconBtn}" Width="34"
                    Click="OpenFolderBtn_Click" ToolTip="Papkani ochish">
              <TextBlock Text="📂" FontSize="14" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Foreground="#FFEEEEEE"/>
            </Button>
          </Grid>
        </StackPanel>
      </Grid>

      <!-- Options -->
      <Grid Grid.Row="2" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Cursor="Hand"
                    MouseLeftButtonUp="AutoPasteToggle">
          <Border x:Name="AutoPasteBorder" Width="16" Height="16" CornerRadius="4"
                  Background="{DynamicResource BrBgInput}"
                  BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                  Margin="0,0,6,0" VerticalAlignment="Center">
            <TextBlock x:Name="AutoPasteMark" Text="" FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrAccent}"/>
          </Border>
          <TextBlock x:Name="LblAutoPaste" Text="Clipboard kuzatish" FontSize="12"
                     Foreground="{DynamicResource BrTextSecondary}" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Cursor="Hand"
                    Margin="16,0,0,0" MouseLeftButtonUp="AutoTitleToggle">
          <Border x:Name="AutoTitleBorder" Width="16" Height="16" CornerRadius="4"
                  Background="{DynamicResource BrBgInput}"
                  BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                  Margin="0,0,6,0" VerticalAlignment="Center">
            <TextBlock x:Name="AutoTitleMark" Text="" FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrAccent}"/>
          </Border>
          <TextBlock x:Name="LblAutoTitle" Text="Sarlavha avtomatik" FontSize="12"
                     Foreground="{DynamicResource BrTextSecondary}" VerticalAlignment="Center"/>
        </StackPanel>

        <Button x:Name="ClearAllBtn" Grid.Column="3" Content="Tozalash"
                Style="{StaticResource SecondaryBtn}" FontSize="11" Click="ClearAllBtn_Click"/>
      </Grid>

      <!-- Add button -->
      <Button x:Name="AddBtn" Grid.Row="3" Height="36"
              Content="Navbatga qo'shish  +"
              Style="{StaticResource PrimaryBtn}" FontSize="13"
              Margin="0,0,0,12" Click="AddBtn_Click"/>

      <!-- Queue -->
      <Border Grid.Row="4" Background="{DynamicResource BrBgCard}"
              CornerRadius="8" BorderBrush="{DynamicResource BrBorder}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="LblQueue" Grid.Row="0" Text="Yuklanma navbati" FontSize="11"
                     Foreground="{DynamicResource BrTextSecondary}" Margin="12,8,12,6"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
            <ItemsControl x:Name="QueueList" Margin="8,0,8,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,5" Background="{DynamicResource BrBgInput}"
                          CornerRadius="6" Padding="10,8">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13"
                                   Foreground="{DynamicResource BrTextPrimary}"
                                   TextTrimming="CharacterEllipsis" FontWeight="Medium"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                                   Foreground="{Binding StatusColor}"
                                   Margin="8,0,6,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="✕"
                                Style="{StaticResource SecondaryBtn}"
                                Width="24" Height="20" FontSize="10" Padding="0"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding CancelVisible}"
                                ToolTip="{Binding CancelTooltip}"/>
                      </Grid>
                      <Grid Grid.Row="1" Margin="0,6,0,0" Visibility="{Binding ProgressVisible}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding Progress}"
                                     Style="{StaticResource DownloadProgress}"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                                   FontSize="10" Margin="6,0,0,0"
                                   Foreground="{DynamicResource BrAccent}"
                                   VerticalAlignment="Center"/>
                      </Grid>
                      <TextBlock Grid.Row="2" Text="{Binding SpeedText}" FontSize="10"
                                 Foreground="{DynamicResource BrTextSecondary}"
                                 Margin="0,2,0,0" Visibility="{Binding ProgressVisible}"/>
                      <TextBlock Grid.Row="3" Text="{Binding LinkShort}" FontSize="10"
                                 Foreground="{DynamicResource BrTextSecondary}"
                                 TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Bottom bar: status + github -->
<Grid Grid.Row="2" Background="{DynamicResource BrBgCard}"
      Margin="0" Height="28">
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>

  <TextBlock x:Name="StatusBar" Grid.Column="0" FontSize="11"
             Foreground="{DynamicResource BrTextSecondary}"
             VerticalAlignment="Center" Margin="16,0,0,0" Text="Tayyor"/>

  <TextBlock x:Name="QueueCountText" Grid.Column="1" FontSize="11"
             Foreground="{DynamicResource BrTextSecondary}"
             VerticalAlignment="Center" Margin="0,0,12,0"/>

  <!-- 👇 faqat shu qism o'zgardi -->
  <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center"
             Margin="0,0,14,0">
    <Hyperlink NavigateUri="https://github.com/iZubayr"
               RequestNavigate="GitHub_Click"
               Foreground="#FF555555"
               TextDecorations="None">
      github.com/iZubayr
    </Hyperlink>
  </TextBlock>

</Grid>

  </Grid>
</Window>